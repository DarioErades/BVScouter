{
  "name": "volleystats-tablet",
  "version": "0.1.0",
  "private": true,
  "description": "VolleyStats Tablet — estadísticas de voleibol en tiempo real para tablets Android",
  "type": "module",
  "scripts": {
    "serve": "npx --yes serve www -l 5180",
    "android:add": "cap add android && node scripts/patch-android.mjs && cap sync android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
